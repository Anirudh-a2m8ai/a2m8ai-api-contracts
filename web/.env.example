# ---------------------------------------------------------------------------
# Copy to .env.local for local dev. In production set these in the Vercel
# dashboard under Settings -> Environment Variables. Never commit real values.
# ---------------------------------------------------------------------------

# --- Who is allowed to edit the contract directly -------------------------
# Your GitHub username, exactly as it appears in your profile URL. This single
# account gets the editor, the Approve/Reject buttons and comment moderation.
# Everyone else is read-and-propose only, no matter what they do in the UI.
OWNER_GITHUB_LOGIN=Anirudh-a2m8ai

# --- GitHub OAuth ---------------------------------------------------------
# Create at https://github.com/settings/developers -> New OAuth App.
#   Homepage URL:               https://<your-app>.vercel.app
#   Authorization callback URL: https://<your-app>.vercel.app/api/auth/callback
# For local dev register a second app pointing at http://localhost:3000.
GITHUB_CLIENT_ID=Ov23lixSYaEAHsvhhaEc
GITHUB_CLIENT_SECRET=f7b478667a5e9fd5c1e455a4dadd5dc1d0af4a61

# --- Session signing ------------------------------------------------------
# Any long random string. Rotating it signs every existing session out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Database -------------------------------------------------------------
# Vercel -> Storage -> Create Database -> Postgres sets POSTGRES_URL for you.
# Set DATABASE_URL only if you are bringing your own Neon/Postgres instance.
# With neither set the site still renders the committed contract, read-only.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Canonical URL (optional) --------------------------------------------
# Pin the OAuth redirect_uri when preview deployments would otherwise send
# GitHub a URL that does not match the one registered on the OAuth app.
# APP_URL=https://<your-app>.vercel.app
